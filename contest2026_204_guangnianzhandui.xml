<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_204_guangnianzhandui" name="contest2026_204_guangnianzhandui">
    <!-- STM32N647 (ATK-DNN647) board support: chip layer + board layer,
         symlinked into the openvela tree where the build expects them. -->
    <linkfile src="board/chips/stm32n6" dest="vendor/st/chips/stm32n6"/>
    <linkfile src="board/boards/stm32n6" dest="vendor/st/boards/stm32n6"/>
  </project>
</manifest>
