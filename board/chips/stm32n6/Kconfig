#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_CHIP_CUSTOM

comment "ST Configuration Options"

choice
    prompt "ST Chip Selection"
    default ARCH_CHIP_STM32N6

config ARCH_CHIP_STM32N6
	bool "stm32n6"
	select ARCH_CORTEXM55
	select ARCH_HAVE_MPU
	select ARM_HAVE_MPU_UNIFIED
	select ARCH_HAVE_FPU

endchoice

config STM32N6_LTDC
	bool "STM32N6 LTDC (parallel RGB LCD controller)"
	default n
	depends on DRIVERS_VIDEO
	---help---
		Enable the LTDC v2 controller driver (st_ltdc.c).  The board
		layer must provide the panel timing, pin table, pixel format
		and frame buffer address (see boards/stm32n6/atk-dnn647).
		Pixel clock: PLL1 VCO / CONFIG_STM32N6_LTDC_IC16_DIV via IC16.

endif
